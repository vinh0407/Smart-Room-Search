<style>
body {
  margin: 0;
  font-family: var(--font-sans, "Plus Jakarta Sans", system-ui, sans-serif);
  background-color: var(--surface-base, #f7f7f5);
  color: var(--ink-primary, #1c1917);
  -webkit-font-smoothing: antialiased;
}
* {
  box-sizing: border-box;
}
.app-header {
  height: 68px;
  background: var(--surface-card, #ffffff);
  border-bottom: 1px solid var(--border-subtle, #e7e5e4);
  padding: 0 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.logo-group {
  display: flex;
  align-items: center;
  gap: 10px;
}
.logo-icon {
  width: 36px;
  height: 36px;
  background: #ea580c;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
}
.logo-text {
  font-size: 19px;
  font-weight: 800;
  letter-spacing: -0.02em;
}
.logo-text span {
  color: #ea580c;
}
.nav-actions {
  display: flex;
  align-items: center;
  gap: 14px;
}
.live-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  padding: 6px 12px;
  border-radius: 9999px;
  font-size: 12px;
  font-weight: 700;
  color: #166534;
}
.pulse {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #16a34a;
}
.btn-primary {
  background: #ea580c;
  color: #ffffff;
  border: none;
  border-radius: 10px;
  height: 40px;
  padding: 0 16px;
  font-weight: 700;
  font-size: 13px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.filter-strip {
  background: #ffffff;
  border-bottom: 1px solid var(--border-subtle, #e7e5e4);
  padding: 12px 28px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.filter-select {
  height: 38px;
  padding: 0 30px 0 12px;
  border-radius: 8px;
  border: 1px solid var(--border-subtle, #e7e5e4);
  background: #f5f5f4;
  font-size: 13px;
  font-weight: 600;
  color: #1c1917;
  outline: none;
}
.source-filters {
  display: flex;
  gap: 6px;
  margin-left: auto;
}
.source-chip {
  padding: 6px 12px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 600;
  border: 1px solid var(--border-subtle, #e7e5e4);
  background: #f5f5f4;
  color: #78716c;
  cursor: pointer;
}
.source-chip.active {
  background: #fff7ed;
  color: #ea580c;
  border-color: #fdba74;
}
.main-layout {
  display: grid;
  grid-template-columns: 580px 1fr;
  height: calc(880px - 68px - 63px);
}
.feed-pane {
  overflow-y: auto;
  padding: 20px 24px;
  border-right: 1px solid var(--border-subtle, #e7e5e4);
  display: flex;
  flex-direction: column;
  gap: 16px;
  background: #fafaf9;
}
.feed-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.feed-title {
  font-size: 16px;
  font-weight: 800;
}
.feed-sub {
  font-size: 13px;
  color: #78716c;
}
.card-item {
  background: #ffffff;
  border-radius: 14px;
  border: 1px solid var(--border-subtle, #e7e5e4);
  overflow: hidden;
  display: flex;
  box-shadow: 0 2px 8px rgba(0,0,0,0.03);
}
.card-thumb {
  width: 170px;
  height: 140px;
  background: #e2e8f0;
  flex-shrink: 0;
  position: relative;
}
.badge-chotot {
  position: absolute;
  top: 8px;
  left: 8px;
  background: rgba(255, 255, 255, 0.94);
  padding: 2px 8px;
  border-radius: 9999px;
  font-size: 10px;
  font-weight: 700;
  color: #ea580c;
}
.card-details {
  padding: 14px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex: 1;
}
.card-price {
  font-size: 17px;
  font-weight: 800;
  color: #ea580c;
}
.card-name {
  font-size: 14px;
  font-weight: 700;
  line-height: 1.3;
  margin: 4px 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card-loc {
  font-size: 12px;
  color: #78716c;
}
.card-tags {
  display: flex;
  gap: 6px;
  margin-top: 6px;
}
.tag-pill {
  font-size: 11px;
  background: #f5f5f4;
  padding: 2px 6px;
  border-radius: 4px;
  color: #57534e;
}
.map-pane {
  position: relative;
  background: #e2e8f0;
}
.map-canvas {
  width: 100%;
  height: 100%;
}
.map-pin {
  position: absolute;
  background: #ea580c;
  color: #ffffff;
  padding: 4px 8px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 800;
  box-shadow: 0 4px 10px rgba(234, 88, 12, 0.35);
  border: 2px solid #ffffff;
}
.pin-1 { top: 240px; left: 180px; }
.pin-2 { top: 160px; left: 340px; }
.pin-3 { top: 380px; left: 260px; background: #2563eb; }
</style>
</helmet>

