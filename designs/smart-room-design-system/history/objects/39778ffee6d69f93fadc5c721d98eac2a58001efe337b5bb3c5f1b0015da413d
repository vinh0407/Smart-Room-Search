<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<style>
body {
  margin: 0;
  padding: 20px;
  background-color: var(--surface-base, #f7f7f5);
  font-family: var(--font-sans, "Plus Jakarta Sans", system-ui, sans-serif);
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
}
.room-card {
  width: 340px;
  background: var(--surface-card, #ffffff);
  border-radius: var(--radius-lg, 20px);
  overflow: hidden;
  border: 1px solid var(--border-subtle, #e7e5e4);
  box-shadow: 0 4px 16px -2px rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
}
.card-image-wrap {
  position: relative;
  width: 100%;
  height: 180px;
  background: linear-gradient(135deg, #cbd5e1 0%, #94a3b8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}
.card-image-svg {
  width: 100%;
  height: 100%;
}
.source-tag {
  position: absolute;
  top: 12px;
  right: 12px;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(4px);
  padding: 4px 10px;
  border-radius: var(--radius-full, 9999px);
  font-size: 11px;
  font-weight: 700;
  color: #ea580c;
  display: inline-flex;
  align-items: center;
  gap: 5px;
}
.tag-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #ea580c;
}
.card-content {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.price-val {
  font-size: 20px;
  font-weight: 800;
  color: var(--brand-primary, #ea580c);
}
.price-unit {
  font-size: 13px;
  font-weight: 500;
  color: var(--ink-muted, #78716c);
}
.card-title {
  font-size: 15px;
  font-weight: 700;
  line-height: 1.35;
  color: var(--ink-primary, #1c1917);
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card-address {
  font-size: 13px;
  color: var(--ink-muted, #78716c);
  margin: 0;
  display: flex;
  align-items: center;
  gap: 4px;
}
.spec-chips {
  display: flex;
  gap: 6px;
  margin-top: 4px;
}
.spec-chip {
  background: var(--surface-muted, #f5f5f4);
  padding: 4px 8px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
  color: var(--ink-primary, #1c1917);
}
</style>
</head>
<body>
  <div class="room-card">
    <div class="card-image-wrap">
      <svg class="card-image-svg" viewBox="0 0 340 180" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="bgGrad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#f1f5f9"/>
            <stop offset="100%" stop-color="#e2e8f0"/>
          </linearGradient>
        </defs>
        <rect width="340" height="180" fill="url(#bgGrad)"/>
        <!-- Window -->
        <rect x="200" y="25" width="90" height="90" rx="6" fill="#bfdbfe" opacity="0.6"/>
        <line x1="245" y1="25" x2="245" y2="115" stroke="#ffffff" stroke-width="2"/>
        <line x1="200" y1="70" x2="290" y2="70" stroke="#ffffff" stroke-width="2"/>
        <!-- Plant -->
        <rect x="235" y="105" width="20" height="16" rx="2" fill="#d97706"/>
        <circle cx="245" cy="98" r="10" fill="#10b981"/>
        <!-- Bed / Sofa -->
        <rect x="30" y="90" width="140" height="55" rx="8" fill="#3b82f6" opacity="0.85"/>
        <rect x="40" y="75" width="40" height="25" rx="4" fill="#60a5fa"/>
        <rect x="90" y="75" width="40" height="25" rx="4" fill="#93c5fd"/>
        <!-- Floor line -->
        <line x1="0" y1="145" x2="340" y2="145" stroke="#cbd5e1" stroke-width="2"/>
      </svg>
      <div class="source-tag">
        <span class="tag-dot"></span>Chợ Tốt Nhà
      </div>
    </div>
    <div class="card-content">
      <div class="price-row">
        <div>
          <span class="price-val">4.500.000</span>
          <span class="price-unit"> đ/tháng</span>
        </div>
        <span style="font-size:12px; color:#78716c;">25 m²</span>
      </div>
      <h3 class="card-title">Phòng trọ ban công thoáng mát, full nội thất gần ĐH Bách Khoa</h3>
      <p class="card-address">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        Phường 14, Quận 10, TP. Hồ Chí Minh
      </p>
      <div class="spec-chips">
        <span class="spec-chip">Máy lạnh</span>
        <span class="spec-chip">Tủ lạnh</span>
        <span class="spec-chip">Ban công</span>
        <span class="spec-chip">WC riêng</span>
      </div>
    </div>
  </div>
</body>
</html>
