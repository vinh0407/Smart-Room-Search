<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<style>
body {
  margin: 0;
  padding: 16px 20px;
  background-color: var(--surface-card, #ffffff);
  font-family: var(--font-sans, "Plus Jakarta Sans", system-ui, sans-serif);
  box-sizing: border-box;
}
.filter-row {
  display: flex;
  gap: 12px;
  align-items: center;
}
.select-group {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.select-label {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--ink-muted, #78716c);
  letter-spacing: 0.05em;
}
.select-input {
  height: 42px;
  padding: 0 12px;
  border-radius: var(--radius-md, 12px);
  border: 1px solid var(--border-subtle, #e7e5e4);
  background: var(--surface-muted, #f5f5f4);
  font-size: 14px;
  font-weight: 600;
  color: var(--ink-primary, #1c1917);
  outline: none;
  cursor: pointer;
  appearance: none;
  background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2378716c' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
  background-repeat: no-repeat;
  background-position: right 12px center;
  background-size: 14px;
}
.select-input:focus {
  border-color: var(--brand-primary, #ea580c);
  background-color: #ffffff;
}
.select-input:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}
</style>
</head>
<body>
  <div class="filter-row">
    <div class="select-group">
      <label class="select-label">Tỉnh / Thành phố</label>
      <select class="select-input">
        <option>Hồ Chí Minh</option>
        <option>Hà Nội</option>
        <option>Đà Nẵng</option>
        <option>Cần Thơ</option>
      </select>
    </div>
    <div class="select-group">
      <label class="select-label">Quận / Huyện</label>
      <select class="select-input">
        <option>Quận 10</option>
        <option>Quận 1</option>
        <option>Bình Thạnh</option>
        <option>Tân Bình</option>
      </select>
    </div>
    <div class="select-group">
      <label class="select-label">Phường / Xã</label>
      <select class="select-input">
        <option>Phường 12</option>
        <option>Phường 14</option>
        <option>Phường 15</option>
      </select>
    </div>
  </div>
</body>
</html>
